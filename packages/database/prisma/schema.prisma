generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMINISTRADOR @map("administrador")
  GERENTE       @map("gerente")
  TECNICO       @map("tecnico")
  CAJERO        @map("cajero")

  @@map("rol_usuario")
}

model Usuario {
  id              String     @id @default(cuid())
  nombre          String
  email           String     @unique
  contrasenaHash  String     @map("contrasena_hash")
  rol             RolUsuario @default(CAJERO)
  activo          Boolean    @default(true)
  creadoEn        DateTime   @default(now()) @map("creado_en")
  actualizadoEn   DateTime   @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

enum TipoCliente {
  REGULAR    @map("regular")
  FRECUENTE  @map("frecuente")
  EMPRESA    @map("empresa")

  @@map("tipo_cliente")
}

enum EstadoCliente {
  ACTIVO    @map("activo")
  VIP       @map("vip")
  INACTIVO  @map("inactivo")

  @@map("estado_cliente")
}

model Cliente {
  id              String        @id @default(cuid())
  nombre          String
  documento       String        @default("")
  telefono        String        @default("")
  email           String        @default("")
  ciudad          String        @default("")
  tipo            TipoCliente   @default(REGULAR)
  estado          EstadoCliente @default(ACTIVO)
  equipoReciente  String        @default("") @map("equipo_reciente")
  notas           String        @default("")
  creadoEn        DateTime      @default(now()) @map("creado_en")
  actualizadoEn   DateTime      @updatedAt @map("actualizado_en")

  @@index([nombre])
  @@index([documento])
  @@index([telefono])
  @@map("clientes")
}

enum TipoEntidadImagen {
  PRODUCTO   @map("producto")
  REPARACION @map("reparacion")
  COMPRA     @map("compra")
  USUARIO    @map("usuario")

  @@map("tipo_entidad_imagen")
}

model Imagen {
  id             String            @id @default(cuid())
  entidadTipo    TipoEntidadImagen @map("entidad_tipo")
  entidadId      String            @map("entidad_id")
  nombreOriginal String            @map("nombre_original")
  nombreArchivo  String            @unique @map("nombre_archivo")
  mimeType       String            @map("mime_type")
  tamanoBytes    Int               @map("tamano_bytes")
  rutaArchivo    String            @map("ruta_archivo")
  esPrincipal    Boolean           @default(false) @map("es_principal")
  orden          Int               @default(0)
  creadoEn       DateTime          @default(now()) @map("creado_en")

  @@index([entidadTipo, entidadId])
  @@map("imagenes")
}
